# Copy this file to .env (same folder) and fill in the values. Never commit .env.

# Gemini API keys (Google AI Studio), comma-separated: Khiratna switches to the next key when one hits its limit
GEMINI_API_KEYS=key1,key2

# Optional: PostgreSQL with the pgvector extension (vector store of Khiratna).
# If it is missing or unreachable, Khiratna uses the local files (same answers).
DATABASE_URL=postgresql://user:password@localhost:5432/khiratna
